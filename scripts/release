#!/bin/bash

set -eu

readonly EXIT_USAGE=2
readonly DEFAULT_KEYCHAIN_PROFILE='qlomni-notary'
readonly DEFAULT_SIGNING_IDENTITY='Developer ID Application: James Klein (NJ4W6LK8LG)'
readonly DEFAULT_TEAM_ID='NJ4W6LK8LG'
readonly APP_RELATIVE_PATH='build/Build/Products/Release/QLOmni.app'
readonly PROJECT_FILE='QLOmni.xcodeproj/project.pbxproj'
readonly README_FILE='README.md'
readonly INTEGRATION_SCRIPT_RELATIVE_PATH='tools/check-release-integration.sh'
readonly TAP_REPOSITORY_SLUG='j-256/homebrew-tap'
readonly TAP_CASK_RELATIVE_PATH='Casks/qlomni.rb'
readonly TAP_AUDIT_OWNER='qlomni-release'
readonly TAP_AUDIT_CASK="$TAP_AUDIT_OWNER/tap/qlomni"
readonly TAP_COMMIT_PREFIX='chore(qlomni): update to '

usage() {
    cat <<'EOF'
Usage: scripts/release [options]

Build and verify a notarized QLOmni artifact, then publish the app and cask.

Options:
  -V, --version X.Y.Z          Exact release version
  -p, --keychain-profile NAME  notarytool Keychain profile (default: qlomni-notary)
  -s, --signing-identity ID    Developer ID identity name or fingerprint
  -t, --team-id TEAM_ID        Expected Developer Team ID
  -T, --tap-directory DIR      j-256/homebrew-tap checkout (default: sibling checkout)
      --dry-run                Build without changing Git, GitHub, or the Homebrew tap
      --resume                 Resume app or cask publication after a local commit
  -h, --help                   Show this help

Environment:
  ASSUME_YES=1                 Skip the local integration-test install prompt
  INTEGRATION=0|1              Skip or force release integration tests
  EXTRA_EXTS                   Must be unset because releases use committed UTIs

The Apple app-specific password is read only by notarytool from the named
Keychain profile. This command never accepts it through the environment.

Exit status:
  0 success, 1 release failure, 2 usage or precondition error
EOF
}

fail_usage() {
    printf 'release: %s\n' "$1" >&2
    printf 'Try release --help for usage.\n' >&2
    exit "$EXIT_USAGE"
}

fail() {
    printf 'release: %s\n' "$1" >&2
    exit 1
}

require_command() {
    if ! command -v "$1" >/dev/null 2>&1; then
        fail "required command not found: $1"
    fi
}

_expand_short_opts() {
    # $1 = string of short-opt letters that take a value (e.g. "nXHd"); "" for flag-only scripts
    # $2..$N = "$@"
    # Populates _EXPANDED; caller does: set -- "${_EXPANDED[@]}"; unset _EXPANDED
    local value_opts="$1"; shift
    _EXPANDED=()
    local passthru=""
    local arg
    local rest
    local c
    for arg in "$@"; do
        if [ -n "$passthru" ]; then _EXPANDED+=("$arg"); continue; fi
        case "$arg" in
            --)       passthru=1; _EXPANDED+=("$arg") ;;
            --*|-|"") _EXPANDED+=("$arg") ;;
            -[a-zA-Z]?*)
                rest="${arg#-}"
                while [ -n "$rest" ]; do
                    c="${rest%"${rest#?}"}"; rest="${rest#?}"
                    _EXPANDED+=("-$c")
                    case "$value_opts" in *"$c"*)
                        [ -n "$rest" ] && _EXPANDED+=("$rest")
                        rest="" ;;
                    esac
                done ;;
            *)        _EXPANDED+=("$arg") ;;
        esac
    done
}

run_release_tests() {
    local integration_status
    local uti_surface

    printf '==> Running release tests\n'
    make test

    uti_surface=$(make --no-print-directory print-uti-surface)

    set +e
    INTEGRATION="${INTEGRATION:-}" UTI_SURFACE="$uti_surface" "$integration_script"
    integration_status=$?
    set -e

    case "$integration_status" in
        0) make release-integration ;;
        1) ;;
        *) fail "integration-test decision failed with status $integration_status" ;;
    esac
}

verify_artifact() {
    local checksum_directory
    local checksum_name

    "$verify_script" \
        --team-id "$team_id" \
        --expected-version "$version" \
        "$release_zip"

    checksum_directory=${checksum_path%/*}
    checksum_name=${checksum_path##*/}
    (
        cd "$checksum_directory"
        shasum -a 256 -c "$checksum_name"
    )
}

tap_git() {
    git -C "$tap_directory" "$@"
}

read_cask_field() {
    local field

    field=$1
    sed -nE "s/^[[:space:]]*$field \"([^\"]+)\"$/\1/p" "$tap_cask_path"
}

validate_cask_file() {
    local cask_sha
    local cask_version
    local sha_count
    local version_count

    version_count=$(read_cask_field version | wc -l | tr -d ' ')
    [ "$version_count" -eq 1 ] || fail "$tap_cask_path must contain exactly one version stanza"
    sha_count=$(read_cask_field sha256 | wc -l | tr -d ' ')
    [ "$sha_count" -eq 1 ] || fail "$tap_cask_path must contain exactly one sha256 stanza"

    cask_version=$(read_cask_field version)
    printf '%s\n' "$cask_version" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$' || fail "invalid cask version: $cask_version"
    cask_sha=$(read_cask_field sha256)
    printf '%s\n' "$cask_sha" | grep -Eq '^[0-9a-f]{64}$' || fail "invalid cask SHA-256: $cask_sha"
}

validate_tap_remote() {
    local tap_remote

    tap_remote=$(tap_git remote get-url origin 2>/dev/null) || fail "Homebrew tap has no origin remote: $tap_directory"
    case "$tap_remote" in
        https://github.com/"$TAP_REPOSITORY_SLUG"|\
        https://github.com/"$TAP_REPOSITORY_SLUG".git|\
        git@github.com:"$TAP_REPOSITORY_SLUG"|\
        git@github.com:"$TAP_REPOSITORY_SLUG".git) ;;
        *) fail "Homebrew tap origin is $tap_remote, expected $TAP_REPOSITORY_SLUG" ;;
    esac
}

unexpected_tap_status() {
    tap_git status --porcelain --untracked-files=normal | awk -v expected="$TAP_CASK_RELATIVE_PATH" '$2 != expected { print }'
}

validate_homebrew_tap_checkout() {
    local ahead_count
    local ahead_subject
    local cask_version
    local changed_paths
    local release_mode
    local tap_branch
    local tap_head
    local tap_origin
    local tap_status
    local unexpected_status

    release_mode=$1

    [ -d "$tap_directory" ] || fail "Homebrew tap checkout not found: $tap_directory"
    tap_git rev-parse --is-inside-work-tree >/dev/null 2>&1 || fail "Homebrew tap path is not a Git checkout: $tap_directory"
    validate_tap_remote
    tap_branch=$(tap_git symbolic-ref --short HEAD 2>/dev/null || true)
    [ -n "$tap_branch" ] || tap_branch='detached'
    [ "$tap_branch" = 'main' ] || fail "Homebrew tap publication requires main; current branch is $tap_branch"
    [ -f "$tap_cask_path" ] || fail "QLOmni cask not found: $tap_cask_path"
    validate_cask_file

    printf '==> Refreshing Homebrew tap origin state\n'
    tap_git fetch origin main
    tap_head=$(tap_git rev-parse HEAD)
    tap_origin=$(tap_git rev-parse origin/main)
    tap_status=$(tap_git status --porcelain --untracked-files=normal)
    unexpected_status=$(unexpected_tap_status)
    [ -z "$unexpected_status" ] || fail "Homebrew tap has unrelated changes; clean $tap_directory before releasing"
    cask_version=$(read_cask_field version)

    if [ "$release_mode" = 'release' ]; then
        [ -z "$tap_status" ] || fail "Homebrew tap must be clean before starting a release: $tap_directory"
        [ "$tap_head" = "$tap_origin" ] || fail 'Homebrew tap main must exactly match origin/main before starting a release'
        [ "$cask_version" != "$version" ] || fail "Homebrew cask already targets $version; use release resume only for an existing matching app release"
        return
    fi

    if [ "$tap_head" = "$tap_origin" ]; then
        if [ -n "$tap_status" ]; then
            [ "$cask_version" = "$version" ] || fail "incomplete Homebrew cask update targets $cask_version, expected $version"
        fi
        return
    fi

    if tap_git merge-base --is-ancestor origin/main HEAD; then
        [ -z "$tap_status" ] || fail 'Homebrew tap has both an unpushed commit and working-tree changes'
        ahead_count=$(tap_git rev-list --count origin/main..HEAD)
        [ "$ahead_count" -eq 1 ] || fail 'Homebrew tap resume requires exactly one unpushed cask commit'
        changed_paths=$(tap_git diff --name-only origin/main..HEAD)
        [ "$changed_paths" = "$TAP_CASK_RELATIVE_PATH" ] || fail 'Homebrew tap unpushed commit changes paths other than the QLOmni cask'
        ahead_subject=$(tap_git log -1 --format=%s)
        [ "$ahead_subject" = "$TAP_COMMIT_PREFIX$version" ] || fail "unexpected Homebrew tap commit: $ahead_subject"
        [ "$cask_version" = "$version" ] || fail "Homebrew tap commit targets $cask_version, expected $version"
        return
    fi

    if tap_git merge-base --is-ancestor HEAD origin/main; then
        fail "Homebrew tap main is behind origin/main; fast-forward $tap_directory, then resume"
    fi
    fail 'Homebrew tap main and origin/main have diverged; reconcile them, then resume'
}

update_cask_file() {
    local checksum

    checksum=$1
    sed -i '' -E "s/^([[:space:]]*version \")[^\"]+(\")$/\1$version\2/" "$tap_cask_path"
    sed -i '' -E "s/^([[:space:]]*sha256 \")[^\"]+(\")$/\1$checksum\2/" "$tap_cask_path"
    validate_cask_file
    [ "$(read_cask_field version)" = "$version" ] || fail 'Homebrew cask version update failed'
    [ "$(read_cask_field sha256)" = "$checksum" ] || fail 'Homebrew cask checksum update failed'
}

validate_cask_release_update() {
    local actual_cask
    local base_cask
    local checksum
    local expected_cask

    checksum=$1
    base_cask=$(tap_git show "origin/main:$TAP_CASK_RELATIVE_PATH") || fail 'could not read the published QLOmni cask'
    expected_cask=$(printf '%s\n' "$base_cask" | sed -E \
        -e "s/^([[:space:]]*version \")[^\"]+(\")$/\1$version\2/" \
        -e "s/^([[:space:]]*sha256 \")[^\"]+(\")$/\1$checksum\2/")
    actual_cask=$(sed -n '1,$p' "$tap_cask_path")
    [ "$actual_cask" = "$expected_cask" ] || fail 'Homebrew cask contains changes beyond the release version and checksum'
}

audit_homebrew_cask() (
    local audit_link
    local audit_link_created
    local audit_parent
    local audit_parent_created
    local audit_status
    local brew_repository
    local cleanup_status

    brew_repository=$(brew --repository)
    [ -d "$brew_repository/Library/Taps" ] || fail "Homebrew tap directory not found below $brew_repository"
    audit_parent="$brew_repository/Library/Taps/$TAP_AUDIT_OWNER"
    audit_link="$audit_parent/homebrew-tap"
    audit_parent_created='false'
    audit_link_created='false'

    cleanup_audit_link() {
        cleanup_status=0
        if [ "$audit_link_created" = 'true' ]; then
            if unlink "$audit_link"; then
                audit_link_created='false'
            else
                printf 'release: could not remove temporary tap link: %s\n' "$audit_link" >&2
                cleanup_status=1
            fi
        fi
        if [ "$audit_parent_created" = 'true' ]; then
            if rmdir "$audit_parent"; then
                audit_parent_created='false'
            else
                printf 'release: could not remove temporary tap directory: %s\n' "$audit_parent" >&2
                cleanup_status=1
            fi
        fi
        return "$cleanup_status"
    }
    trap cleanup_audit_link EXIT HUP INT TERM

    [ ! -e "$audit_link" ] && [ ! -L "$audit_link" ] || fail "temporary Homebrew tap path already exists: $audit_link"
    if [ ! -d "$audit_parent" ]; then
        mkdir -p "$audit_parent"
        audit_parent_created='true'
    fi
    ln -s "$tap_directory" "$audit_link"
    audit_link_created='true'

    printf '==> Auditing Homebrew cask\n'
    set +e
    HOMEBREW_NO_AUTO_UPDATE=1 brew audit --cask --strict --online "$TAP_AUDIT_CASK"
    audit_status=$?
    set -e
    cleanup_status=0
    cleanup_audit_link || cleanup_status=$?
    trap - EXIT HUP INT TERM
    [ "$audit_status" -eq 0 ] || return "$audit_status"
    [ "$cleanup_status" -eq 0 ] || fail 'temporary Homebrew audit tap cleanup failed'
)

publish_homebrew_cask() {
    local checksum
    local expected_origin
    local staged_paths
    local tap_head
    local tap_origin
    local tap_status

    # Keep the cask tied to the same verified bytes published in the GitHub Release
    verify_artifact
    checksum=$(awk 'NR == 1 { print $1 }' "$checksum_path")
    printf '%s\n' "$checksum" | grep -Eq '^[0-9a-f]{64}$' || fail "invalid release checksum: $checksum"

    validate_homebrew_tap_checkout 'resume'
    tap_head=$(tap_git rev-parse HEAD)
    tap_origin=$(tap_git rev-parse origin/main)
    tap_status=$(tap_git status --porcelain --untracked-files=normal)

    if [ "$tap_head" = "$tap_origin" ] && [ -z "$tap_status" ] && \
        [ "$(read_cask_field version)" = "$version" ] && [ "$(read_cask_field sha256)" = "$checksum" ]; then
        printf 'Homebrew cask already published for %s\n' "$version"
        return
    fi

    if [ "$tap_head" = "$tap_origin" ] && [ -z "$tap_status" ]; then
        printf '==> Updating Homebrew cask to %s\n' "$version"
        update_cask_file "$checksum"
    else
        [ "$(read_cask_field version)" = "$version" ] || fail 'preserved Homebrew cask version does not match the release'
        [ "$(read_cask_field sha256)" = "$checksum" ] || fail 'preserved Homebrew cask checksum does not match the verified artifact'
    fi

    validate_cask_release_update "$checksum"
    [ -z "$(unexpected_tap_status)" ] || fail 'Homebrew tap gained unrelated changes during publication'
    tap_git diff --check
    audit_homebrew_cask

    tap_git add "$TAP_CASK_RELATIVE_PATH"
    tap_git diff --cached --check
    staged_paths=$(tap_git diff --cached --name-only)
    if [ -n "$staged_paths" ]; then
        [ "$staged_paths" = "$TAP_CASK_RELATIVE_PATH" ] || fail 'Homebrew tap staged paths other than the QLOmni cask'
        tap_git commit -m "$TAP_COMMIT_PREFIX$version" -- "$TAP_CASK_RELATIVE_PATH"
    fi

    validate_cask_release_update "$checksum"
    [ -z "$(tap_git status --porcelain --untracked-files=normal)" ] || fail 'Homebrew tap is not clean after its release commit'
    tap_head=$(tap_git rev-parse HEAD)
    tap_origin=$(tap_git rev-parse origin/main)
    if [ "$tap_head" = "$tap_origin" ]; then
        printf 'Homebrew cask already published for %s\n' "$version"
        return
    fi

    expected_origin=$tap_origin
    verify_artifact
    tap_git fetch origin main
    tap_origin=$(tap_git rev-parse origin/main)
    [ "$tap_origin" = "$expected_origin" ] || fail 'Homebrew tap origin advanced during release; reconcile it, then resume'

    printf '==> Publishing Homebrew cask %s\n' "$version"
    tap_git push origin HEAD:refs/heads/main
    tap_git fetch origin main
    [ "$(tap_git rev-parse origin/main)" = "$(tap_git rev-parse HEAD)" ] || fail 'Homebrew tap push could not be verified'
}

build_artifact() {
    mkdir -p "${release_zip%/*}"
    make build VERSION="$version"
    "$package_script" \
        --app "$APP_RELATIVE_PATH" \
        --output "$release_zip" \
        --keychain-profile "$keychain_profile" \
        --signing-identity "$signing_identity" \
        --team-id "$team_id" \
        --expected-version "$version"
    verify_artifact
}

remote_tag_commit() {
    local listing
    local peeled
    local direct

    listing=$(git ls-remote origin "refs/tags/$tag" "refs/tags/$tag^{}") || return 2
    [ -n "$listing" ] || return 1
    peeled=$(printf '%s\n' "$listing" | awk '$2 ~ /\^\{\}$/ { print $1; exit }')
    direct=$(printf '%s\n' "$listing" | awk '$2 !~ /\^\{\}$/ { print $1; exit }')
    if [ -n "$peeled" ]; then
        printf '%s\n' "$peeled"
    else
        printf '%s\n' "$direct"
    fi
}

ensure_local_tag() {
    local tagged_commit

    if git rev-parse --verify --quiet "refs/tags/$tag" >/dev/null; then
        tagged_commit=$(git rev-list -n 1 "$tag")
        [ "$tagged_commit" = "$release_commit" ] || fail "$tag points at $tagged_commit, expected $release_commit"
        return
    fi

    printf '==> Creating annotated tag %s\n' "$tag"
    git tag -a "$tag" -m "$version"
}

publish_release() {
    local origin_tag_commit
    local remote_tag_status
    local checksum
    local notes

    # This is the final local gate before any remote mutation
    verify_artifact
    ensure_local_tag

    printf '==> Refreshing origin state\n'
    git fetch origin main

    origin_tag_commit=''
    set +e
    origin_tag_commit=$(remote_tag_commit)
    remote_tag_status=$?
    set -e
    if [ "$remote_tag_status" -eq 0 ]; then
        [ "$origin_tag_commit" = "$release_commit" ] || fail "$tag on origin points at $origin_tag_commit, expected $release_commit"
        git merge-base --is-ancestor "$release_commit" origin/main || fail "$tag is remote but its release commit is not on origin/main"
    elif [ "$remote_tag_status" -eq 2 ]; then
        fail "could not inspect $tag on origin"
    elif git merge-base --is-ancestor "$release_commit" origin/main; then
        printf '==> Publishing %s\n' "$tag"
        git push origin "refs/tags/$tag:refs/tags/$tag"
    elif git merge-base --is-ancestor origin/main "$release_commit"; then
        printf '==> Atomically publishing main and %s\n' "$tag"
        git push --atomic origin \
            "$release_commit:refs/heads/main" \
            "refs/tags/$tag:refs/tags/$tag"
    else
        fail 'main and origin/main have diverged; reconcile them, then rerun make release-resume'
    fi

    # Recheck the same local bytes immediately before creating or repairing the release
    verify_artifact
    checksum=$(awk 'NR == 1 { print $1 }' "$checksum_path")
    notes="QLOmni $version is Developer ID signed and notarized by Apple.

SHA-256: \`$checksum\`"

    if gh release view "$tag" >/dev/null 2>&1; then
        printf '==> Repairing assets on existing GitHub Release %s\n' "$tag"
        gh release upload "$tag" "$release_zip" "$checksum_path" --clobber
    else
        printf '==> Creating GitHub Release %s\n' "$tag"
        gh release create "$tag" "$release_zip" "$checksum_path" \
            --verify-tag \
            --title "$tag" \
            --generate-notes \
            --notes "$notes"
    fi

    publish_homebrew_cask
}

version=''
keychain_profile=$DEFAULT_KEYCHAIN_PROFILE
signing_identity=$DEFAULT_SIGNING_IDENTITY
team_id=$DEFAULT_TEAM_ID
tap_directory=''
mode='release'
invocation_directory=$(pwd)

if [ "$#" -gt 0 ]; then
    _expand_short_opts "TVpst" "$@"
    set -- "${_EXPANDED[@]}"; unset _EXPANDED
fi

while [ "$#" -gt 0 ]; do
    case "$1" in
        -V|--version)
            [ "$#" -ge 2 ] && [ -n "$2" ] || fail_usage '--version requires a value'
            version=$2
            shift 2
            ;;
        --version=*)
            version=${1#*=}
            [ -n "$version" ] || fail_usage '--version requires a value'
            shift
            ;;
        -p|--keychain-profile)
            [ "$#" -ge 2 ] && [ -n "$2" ] || fail_usage '--keychain-profile requires a value'
            keychain_profile=$2
            shift 2
            ;;
        --keychain-profile=*)
            keychain_profile=${1#*=}
            [ -n "$keychain_profile" ] || fail_usage '--keychain-profile requires a value'
            shift
            ;;
        -s|--signing-identity)
            [ "$#" -ge 2 ] && [ -n "$2" ] || fail_usage '--signing-identity requires a value'
            signing_identity=$2
            shift 2
            ;;
        --signing-identity=*)
            signing_identity=${1#*=}
            [ -n "$signing_identity" ] || fail_usage '--signing-identity requires a value'
            shift
            ;;
        -t|--team-id)
            [ "$#" -ge 2 ] && [ -n "$2" ] || fail_usage '--team-id requires a value'
            team_id=$2
            shift 2
            ;;
        --team-id=*)
            team_id=${1#*=}
            [ -n "$team_id" ] || fail_usage '--team-id requires a value'
            shift
            ;;
        -T|--tap-directory)
            [ "$#" -ge 2 ] && [ -n "$2" ] || fail_usage '--tap-directory requires a value'
            tap_directory=$2
            shift 2
            ;;
        --tap-directory=*)
            tap_directory=${1#*=}
            [ -n "$tap_directory" ] || fail_usage '--tap-directory requires a value'
            shift
            ;;
        --dry-run)
            [ "$mode" = 'release' ] || fail_usage '--dry-run and --resume cannot be combined'
            mode='dry-run'
            shift
            ;;
        --resume)
            [ "$mode" = 'release' ] || fail_usage '--dry-run and --resume cannot be combined'
            mode='resume'
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        --)
            shift
            [ "$#" -eq 0 ] || fail_usage "unexpected argument: $1"
            ;;
        -*) fail_usage "unknown option: $1" ;;
        *) fail_usage "unexpected argument: $1" ;;
    esac
done

[ -n "$version" ] || fail_usage '--version is required'
printf '%s\n' "$version" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$' || fail_usage "version must be X.Y.Z: $version"
[ "$signing_identity" != '-' ] || fail_usage 'ad-hoc signing is not allowed for releases'
[ -z "${EXTRA_EXTS:-}" ] || fail_usage 'EXTRA_EXTS must be unset for releases'

for command_name in awk git grep make shasum; do
    require_command "$command_name"
done
if [ "$mode" != 'dry-run' ]; then
    require_command gh
    require_command brew
fi

script_directory=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
repository_root=$(CDPATH='' cd -- "$script_directory/.." && pwd)
if [ -z "$tap_directory" ]; then
    repository_parent=$(dirname "$repository_root")
    tap_directory="$repository_parent/homebrew-tap"
else
    case "$tap_directory" in
        /*) ;;
        *) tap_directory="$invocation_directory/$tap_directory" ;;
    esac
fi
if [ "$mode" != 'dry-run' ]; then
    [ -d "$tap_directory" ] || fail "Homebrew tap checkout not found: $tap_directory"
    tap_directory=$(CDPATH='' cd -- "$tap_directory" && pwd)
    tap_cask_path="$tap_directory/$TAP_CASK_RELATIVE_PATH"
else
    tap_cask_path=''
fi
package_script="$script_directory/package-release"
verify_script="$script_directory/verify-release"
integration_script="$repository_root/$INTEGRATION_SCRIPT_RELATIVE_PATH"
tag="v$version"

[ -x "$package_script" ] || fail "packaging script is not executable: $package_script"
[ -x "$verify_script" ] || fail "verification script is not executable: $verify_script"
[ -x "$integration_script" ] || fail "integration decision script is not executable: $integration_script"

cd "$repository_root"

[ -z "$(git status --porcelain --untracked-files=normal)" ] || fail 'working tree must be clean, including untracked files'

if [ "$mode" = 'dry-run' ]; then
    release_zip="$repository_root/build/releases/dry-run/QLOmni-$version.zip"
    checksum_path="$release_zip.sha256"
    [ ! -e "$release_zip" ] || fail_usage "output already exists: $release_zip"
    [ ! -e "$checksum_path" ] || fail_usage "checksum already exists: $checksum_path"
    dry_run_completed='false'
    trap 'if [ "$dry_run_completed" = "false" ]; then rm -f "$release_zip" "$checksum_path"; fi' EXIT
    trap 'exit 130' HUP INT TERM
    run_release_tests
    build_artifact
    dry_run_completed='true'
    printf 'Dry run complete; Git and GitHub were not changed\n'
    printf '%s\n%s\n' "$release_zip" "$checksum_path"
    exit 0
fi

branch=$(git symbolic-ref --short HEAD 2>/dev/null || true)
[ "$branch" = 'main' ] || fail "release publication requires main; current branch is ${branch:-detached}"

release_zip="$repository_root/build/releases/QLOmni-$version.zip"
checksum_path="$release_zip.sha256"
release_commit=''
release_mutation_started='false'
release_commit_created='false'
completed='false'

cleanup() {
    local status

    status=$?
    if [ "$completed" = 'true' ]; then
        return
    fi

    if [ "$release_commit_created" = 'true' ]; then
        printf '\nRelease stopped after the local release commit was created.\n' >&2
        printf 'The verified artifact, any local tag, and Homebrew tap state were preserved.\n' >&2
        printf 'Resolve the reported problem, then run:\n' >&2
        printf '  make release-resume V=%s\n' "$version" >&2
    elif [ "$release_mutation_started" = 'true' ]; then
        git restore --source=HEAD --staged --worktree -- "$PROJECT_FILE" "$README_FILE" >/dev/null 2>&1 || true
        rm -f "$release_zip" "$checksum_path"
        printf '\nRelease failed before its commit; version files and release outputs were restored.\n' >&2
    fi
    return "$status"
}
trap cleanup EXIT
trap 'exit 130' HUP INT TERM

if [ "$mode" = 'resume' ]; then
    current_version=$(make --no-print-directory print-version)
    [ "$current_version" = "$version" ] || fail "project version is $current_version, expected $version"
    [ "$(git log -1 --format=%s)" = "$version" ] || fail "HEAD is not the $version release commit"
    release_commit=$(git rev-parse HEAD)
    release_commit_created='true'
    validate_homebrew_tap_checkout 'resume'
    gh auth status >/dev/null
    gh repo view --json nameWithOwner >/dev/null

    if [ -e "$release_zip" ] && [ ! -e "$checksum_path" ]; then
        fail "checksum is missing for $release_zip; move the incomplete artifact aside and rerun"
    fi
    if [ ! -e "$release_zip" ] && [ -e "$checksum_path" ]; then
        fail "artifact is missing for $checksum_path; move the orphan checksum aside and rerun"
    fi
    if [ -e "$release_zip" ]; then
        verify_artifact
    else
        build_artifact
    fi
    publish_release
    completed='true'
    printf 'Released %s\n' "$tag"
    exit 0
fi

validate_homebrew_tap_checkout 'release'
[ ! -e "$release_zip" ] || fail_usage "output already exists: $release_zip"
[ ! -e "$checksum_path" ] || fail_usage "checksum already exists: $checksum_path"
git fetch origin main
git merge-base --is-ancestor origin/main HEAD || fail 'origin/main is not an ancestor of HEAD; reconcile main before releasing'
git rev-parse --verify --quiet "refs/tags/$tag" >/dev/null && fail "$tag already exists locally; use make release-resume only for its matching release commit"
set +e
remote_tag_commit >/dev/null
remote_tag_status=$?
set -e
if [ "$remote_tag_status" -eq 0 ]; then
    fail "$tag already exists on origin"
fi
if [ "$remote_tag_status" -eq 2 ]; then
    fail "could not inspect $tag on origin"
fi
gh auth status >/dev/null
gh repo view --json nameWithOwner >/dev/null
if gh release view "$tag" >/dev/null 2>&1; then
    fail "GitHub Release $tag already exists"
fi

run_release_tests
release_mutation_started='true'
make version V="$version"
build_artifact

unexpected_paths=$(git status --porcelain --untracked-files=normal | awk '$2 != "QLOmni.xcodeproj/project.pbxproj" && $2 != "README.md" { print }')
if [ -n "$unexpected_paths" ]; then
    printf 'release: release preparation changed unexpected paths:\n%s\n' "$unexpected_paths" >&2
    exit 1
fi
git diff --check
git add "$PROJECT_FILE" "$README_FILE"
git diff --cached --quiet && fail 'version update produced no commit changes'
git commit -m "$version" -- "$PROJECT_FILE" "$README_FILE"
release_commit=$(git rev-parse HEAD)
release_commit_created='true'

ensure_local_tag
publish_release
completed='true'
printf 'Released %s\n' "$tag"
